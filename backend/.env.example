NODE_ENV=development
PORT=4000

# PostgreSQL connection string, e.g. postgres://user:password@localhost:5432/myapp
DATABASE_URL=

# Secret used to sign JWTs - generate a long random string
JWT_SECRET=

# JWT expiry (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed CORS origins
FRONTEND_URL=http://localhost:5173

# Default timezone used when a user has not set one (IANA name)
DEFAULT_TIMEZONE=Africa/Windhoek

# Used only by the seed script to create the initial (only) user
SEED_USERNAME=admin
SEED_EMAIL=admin@example.com
SEED_PASSWORD=changeme123

# Optional: Strava integration. Leave unset to disable it entirely (routes
# return 400). Register a free app at strava.com/settings/api - set its
# "Authorization Callback Domain" to localhost in development.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:4000/api/integrations/strava/callback
